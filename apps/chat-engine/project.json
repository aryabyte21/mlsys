{
  "name": "chat-engine",
  "projectType": "application",
  "sourceRoot": "apps/chat-engine",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose build",
        "cwd": "apps/chat-engine"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose up --build -d",
        "cwd": "apps/chat-engine"
      }
    },
    "stop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose stop",
        "cwd": "apps/chat-engine"
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose logs -f",
        "cwd": "apps/chat-engine"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/request-example.sh",
        "cwd": "apps/chat-engine"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check app/",
        "cwd": "apps/chat-engine"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff format app/",
        "cwd": "apps/chat-engine"
      }
    },
    "push-image": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "docker compose build",
          "docker tag chat-engine:latest ghcr.io/$GITHUB_USERNAME/chat-engine:latest",
          "docker push ghcr.io/$GITHUB_USERNAME/chat-engine:latest"
        ],
        "cwd": "apps/chat-engine",
        "parallel": false
      }
    }
  }
}
